# ============================================================
#  Entorno
# ============================================================
# "production" en cualquier servidor real (cPanel lo fija con el modo de la
# aplicación). Activa las validaciones de arranque, p. ej. exigir
# APP_PUBLIC_URL antes de levantar.
# NODE_ENV=production

# ============================================================
#  Base de datos
# ============================================================
# Motor a usar: "postgres" (desarrollo local) o "mysql" (cPanel).
DB_TYPE=postgres

# --- PostgreSQL (desarrollo local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=medicore

# --- MySQL (ejemplo para despliegue en cPanel) ---
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=cpaneluser_dbuser
# DB_PASSWORD=tu_password_seguro
# DB_NAME=cpaneluser_dbname

# Sincroniza el esquema automáticamente a partir de las entidades.
# Útil en desarrollo; DEBE quedar en "false" en producción (cPanel) -> usa migraciones.
DB_SYNCHRONIZE=false

# ============================================================
#  JWT
# ============================================================
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_y_aleatorio
JWT_REFRESH_EXPIRES_IN=7d
# Recuperación de contraseña (M3). Si se omiten, cae en JWT_ACCESS_SECRET / 30m.
JWT_RESET_SECRET=cambia_esto_por_otro_secreto_largo_y_aleatorio
JWT_RESET_EXPIRES_IN=30m
# Verificación de correo (M4). Si se omiten, cae en JWT_ACCESS_SECRET / 30m.
JWT_VERIFY_SECRET=cambia_esto_por_otro_secreto_largo_y_aleatorio
JWT_VERIFY_EXPIRES_IN=30m

# ============================================================
#  App
# ============================================================
# En cPanel, Passenger asigna el puerto automáticamente; deja PORT sin definir.
# PORT=3000
# URL del frontend, base de los magic links (recuperación y verificación).
# En producción: https://tudominio.com
APP_WEB_URL=http://localhost:4200
# Días que se conserva una cuenta dada de baja antes de poder purgarla
# físicamente (LFPDPPP). La purga NO es automática: se lanza a mano con
# `pnpm purge:accounts` (simulación) y `pnpm purge:accounts -- --confirm`.
ACCOUNT_RETENTION_DAYS=90
# Vigencia de publicación de una vacante (T20), en días desde su alta. La
# ficha pública muestra "Vigente hasta" desde el día 1; el cierre lo ejecuta
# `pnpm vacancies:expire` (engancharlo a cron). 0 = las vacantes no vencen.
VACANCY_LIFETIME_DAYS=60
# Umbrales de aviso antes de que venza la suscripción de una empresa (T22),
# en días y separados por comas. Los envía `pnpm billing:expire`, que también
# caduca las suscripciones vencidas. Vacío = no se avisa.
SUBSCRIPTION_EXPIRY_NOTICE_DAYS=30,7,1
# Orígenes permitidos por CORS (coma-separado). En producción, restríngelo al
# dominio del frontend. Si se omite, se permite cualquier origen (solo dev).
# CORS_ORIGIN=https://tudominio.com

# ============================================================
#  Correo electrónico — T21
# ============================================================
# El adaptador se elige por configuración, en este orden:
#   1. SMTP_HOST -> SMTP con nodemailer (Gmail u otro proveedor).
#   2. ninguna   -> consola: el correo sólo se escribe en el log (dev).
#
# --- Gmail SMTP (recomendado) ---
# Genera una "Clave de aplicación" en: https://myaccount.google.com/apppasswords
# (requiere tener la verificación en 2 pasos activada en la cuenta de Google).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx   <-- clave de aplicación de 16 caracteres
# Entrecomilla el valor: en cPanel el wrapper de node del venv lee el .env
# como script de shell, y sin comillas el "<" se interpreta como redirección.
# SMTP_FROM="Impulso Jobs <tu-correo@gmail.com>"
# Opcional: dirección a la que va la respuesta si el usuario contesta.
# MAIL_REPLY_TO=hola@impulsojobs.com

# ============================================================
#  Archivos subidos (almacenamiento LOCAL, decisión cPanel)
# ============================================================
# Raíz de los archivos subidos. Si se omite: <raíz de la app>/uploads.
# `uploads/public` se sirve estático en /uploads (foto de perfil, logo);
# `uploads/candidate-resumes` es privado (los CV bajan por endpoint con JWT).
# En cPanel el default sirve: ~/api/uploads sobrevive a los deploys por git.
# UPLOADS_DIR=/home/usuario/api/uploads
# URL pública del backend, base de las URLs de imagen que se guardan en BD.
# En producción: la del subdominio del API. En desarrollo, si se omite, cae a
# http://localhost:PORT y lo avisa por consola.
# OJO: la URL se PERSISTE en la fila (companies.logo_url,
# candidate_profiles.profile_photo_url), así que desplegar sin esta variable
# deja imágenes rotas que definirla luego NO arregla — hay que reescribirlas
# con `pnpm uploads:rehost` (T23). Por eso, con NODE_ENV=production y sin
# APP_PUBLIC_URL, el backend arranca en fallo en lugar de guardar localhost.
# APP_PUBLIC_URL=https://api.tudominio.com

# --- Pagos en línea (Stripe) ---
# Sin STRIPE_SECRET_KEY el pago en línea se deshabilita y la empresa sólo ve la
# "solicitud de pago" (transferencia que confirma el equipo en /admin/pagos).
# Webhook a registrar en Stripe: <API>/api/v1/payments/stripe/webhook, con los
# eventos checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, invoice.paid
# y customer.subscription.deleted. En local:
#   stripe listen --forward-to localhost:3000/api/v1/payments/stripe/webhook
# y pega aquí el whsec_ que imprime. La versión de API va fijada a la del SDK
# instalado (stripe@17.5.0): no la cambies sin subir el paquete.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_VERSION=2024-12-18.acacia
