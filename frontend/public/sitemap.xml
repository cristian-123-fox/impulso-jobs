<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap estático del portal público.

  Sólo se listan las rutas que existen sin datos: las de vacantes y landings
  dependen de la base de datos y crecerán con cada publicación, así que su
  listado tendrá que generarse desde la API (`GET /api/v1/vacancies`) cuando
  se aborde el sitemap dinámico. Mientras tanto, Google al menos recibe XML en
  `/sitemap.xml` en lugar del cascarón HTML de Angular.

  Mantener `lastmod` al día en cada cambio de contenido relevante.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://impulsojobs.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://impulsojobs.com/vacantes</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://impulsojobs.com/planes</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://impulsojobs.com/nosotros</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://impulsojobs.com/contacto</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://impulsojobs.com/faq</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
