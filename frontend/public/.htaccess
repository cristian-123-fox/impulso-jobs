# Impulso Jobs - Apache/cPanel, despliegue ESTATICO (opcion B de DEPLOY-CPANEL.md)
#
# Este archivo se copia a dist/frontend/browser/ en el build. Solo tiene efecto
# si sirves esa carpeta con Apache. En el despliegue SSR (opcion A, la
# recomendada) el ruteo lo hace Node y este archivo se ignora.
#
# ##########################################################################
# EL FALLBACK ES index.csr.html, NO index.html. NO LO CAMBIES.
#
# `index.html` es la PORTADA prerenderizada (la home completa: contenido,
# título, descripción, Open Graph y JSON-LD). Apache la sirve sola en `/` por
# DirectoryIndex.
#
# El resto de rutas (/vacantes, /vacantes/<id>, /trabajo/<landing>) tiene que
# recibir el cascarón CSR, no la portada. Si el fallback apuntara a index.html,
# `/vacantes` devolvería el HTML de la home y la hidratación de Angular
# fallaría: el router espera la vista de vacantes, no la portada.
#
# index.csr.html sí es el cascarón y arranca Angular con normalidad.
# ##########################################################################

RewriteEngine On
RewriteBase /

# Si el rewrite no corre (AllowOverride), que `/` al menos sirva el cascarón
# correcto y no un 403.
DirectoryIndex index.csr.html

# La entrada de la plataforma es el listado de vacantes: quien llega nuevo
# viene a postularse. Va antes que nada para que `/` no caiga en el
# DirectoryIndex y sirva el cascarón vacío.
RewriteRule ^$ /vacantes [R=301,L]

# Redirige HTTP -> HTTPS (opcional; deja comentado si usas otro metodo de SSL).
# OJO: si en cPanel ya activaste "Force HTTPS Redirect", NO descomentes esto,
# porque las dos reglas juntas tambien producen un bucle de redirecciones.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Un archivo o carpeta que existe se sirve tal cual. Esto cubre los assets y
# tambien las rutas prerenderizadas (/inicio/index.html, /nosotros/index.html,
# /planes/, /faq/, /contacto/, /auth/**), que asi conservan su HTML servido.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# El resto (/vacantes, /vacantes/<uuid>-<slug>, /trabajo/<landing>) lo resuelve
# Angular en el cliente a partir del cascaron CSR.
RewriteRule ^ index.csr.html [L]

# --- Compresion ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Cache ---
<IfModule mod_headers.c>
  # Los assets llevan hash en el nombre (outputHashing: all) -> cache larga.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Los HTML de entrada nunca se cachean, para que un deploy se tome de inmediato.
  <FilesMatch "^index(\.csr)?\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
