# ============================================================
#  Impulso Jobs — .env del despliegue con Docker (DEPLOY-DOCKER.md)
# ============================================================
# Copia este archivo al servidor como `.env`, junto a docker-compose.prod.yml,
# con permisos 600. Lo leen dos cosas a la vez:
#   - Compose, para interpolar el archivo (TAG, credenciales de PostgreSQL).
#   - La API y la tarea `migrate`, como entorno (env_file).
# NUNCA lo subas al repositorio. La lista completa de variables de la API,
# comentada, está en backend/.env.example.

# ------------------------------------------------------------
#  Imágenes
# ------------------------------------------------------------
# El despliegue automático reescribe TAG con `sha-<commit>`. Para un rollback,
# pon aquí el tag anterior y ejecuta `docker compose ... up -d`.
TAG=latest
IMAGE_REGISTRY=ghcr.io/cristian-123-fox

# Puertos en 127.0.0.1 a los que apunta el Nginx del host.
BACKEND_PORT=3000
FRONTEND_PORT=4000

# Semillas idempotentes que `migrate` corre tras las migraciones en cada
# despliegue. Vacío (MIGRATE_SEEDS=) = sólo migraciones.
MIGRATE_SEEDS=rbac,applications,plan-features

# Hosts extra que acepta el SSR, además de los de angular.json
# (impulsojobs.com, www, demo, localhost). Separados por comas.
# NG_ALLOWED_HOSTS=staging.impulsojobs.com

# ------------------------------------------------------------
#  API
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------
#  Base de datos — el servicio `postgres` del compose
# ------------------------------------------------------------
# DB_HOST es el nombre del servicio, no localhost. Para MySQL externo, cambia
# DB_TYPE/DB_HOST/DB_PORT y quita el servicio `postgres` (ver DEPLOY-DOCKER.md).
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=impulso
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_NAME=impulso_jobs
DB_SYNCHRONIZE=false

# ------------------------------------------------------------
#  JWT — genera cada uno con: openssl rand -hex 32
# ------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=30m
JWT_VERIFY_SECRET=
JWT_VERIFY_EXPIRES_IN=30m

# ------------------------------------------------------------
#  URLs
# ------------------------------------------------------------
# Sin APP_PUBLIC_URL la API no arranca (NODE_ENV=production).
APP_WEB_URL=https://impulsojobs.com
APP_PUBLIC_URL=https://api.impulsojobs.com
CORS_ORIGIN=https://impulsojobs.com,https://www.impulsojobs.com

# Dentro del contenedor. No lo cambies: es el punto de montaje del volumen.
UPLOADS_DIR=/app/uploads

# ------------------------------------------------------------
#  Correo (SMTP). Sin SMTP_HOST el correo sólo se escribe en el log.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=impulsowebjobs@gmail.com
SMTP_PASS=
SMTP_FROM="Impulso Jobs <impulsowebjobs@gmail.com>"
# MAIL_REPLY_TO=

# ------------------------------------------------------------
#  Stripe. Sin STRIPE_SECRET_KEY sólo se ofrece la solicitud de pago.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-12-18.acacia

# ------------------------------------------------------------
#  Google (mismo Client ID que environment.production.ts)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
#  Reglas de negocio
# ------------------------------------------------------------
ACCOUNT_RETENTION_DAYS=90
VACANCY_LIFETIME_DAYS=60
SUBSCRIPTION_EXPIRY_NOTICE_DAYS=7
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
